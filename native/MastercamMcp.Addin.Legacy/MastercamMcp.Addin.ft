APPLICATION "MastercamMcp"
FUNC_DLL   "MastercamMcp.Addin.dll"
RES_DLL    "SAME"
CATEGORY   "Mastercam MCP"

FUNCTION NET "Run"
    dnTIP  "Mastercam MCP"
END_FUNCTION
