{
  "name": "mastercam-mcp",
  "version": "0.2.0",
  "description": "A secure local MCP bridge for a live Mastercam session",
  "repository": {
    "type": "git",
    "url": "https://github.com/Praket7/mastercam-mcp.git"
  },
  "homepage": "https://github.com/Praket7/mastercam-mcp#readme",
  "bugs": {
    "url": "https://github.com/Praket7/mastercam-mcp/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "mastercam-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "native/MastercamMcp.Protocol/**/*",
    "native/MastercamMcp.Core/**/*",
    "native/MastercamMcp.Adapter.Abstractions/**/*",
    "native/MastercamMcp.Addin/**/*",
    "native/MastercamMcp.Addin.Legacy/**/*",
    "native/MastercamMcp.Addin.2027/**/*",
    "native/MastercamMcp.ApiCatalog/**/*",
    "docs",
    "install.ps1",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/**/*.test.ts",
    "test:watch": "node --test --import tsx --watch test/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "mock": "node dist/mock-backend.js",
    "catalog": "node dist/catalog.js",
    "prepack": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.0.0",
    "isomorphic-git": "^1.42.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0"
}